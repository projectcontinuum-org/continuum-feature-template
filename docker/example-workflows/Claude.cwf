                "y": 576
            },
            "data": {
                "id": "org.projectcontinuum.feature.base.analytics.node.CreateTableNodeModel",
                "description": "Creates a structured table from FreeMarker template configuration",
                "title": "Create Table",
                "subTitle": "Generate table rows from template",
                "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" stroke=\"currentColor\" strokeWidth={1.5} viewBox=\"0 0 24 24\">\n\t<path d=\"M21.5 2h-19a.5.5 0 0 0-.5.5v19a.5.5 0 0 0 .5.5h19a.5.5 0 0 0 .5-.5v-19a.5.5 0 0 0-.5-.5zm-13 19H3v-5.5h5.5V21zm0-6.5H3v-5h5.5v5zm0-6H3V3h5.5v5.5zm6 12.5h-5v-5.5h5V21zm0-6.5h-5v-5h5v5zm0-6h-5V3h5v5.5zM21 21h-5.5v-5.5H21V21zm0-6.5h-5.5v-5H21v5zm0-6h-5.5V3H21v5.5z\" fill=\"currentColor\"/>\n</svg>",
                "nodeModel": "org.projectcontinuum.feature.base.analytics.node.CreateTableNodeModel",
                "busy": null,
                "inputs": null,
                "outputs": {
                    "data": {
                        "name": "output table",
                        "contentType": "text/plain"
                    }
                },
                "properties": {
                    "jsonArrayString": "[\n<#-- Generate normal data around mean=100, with some outliers -->\n<#list 1..1000 as i>\n  <#-- Normal values between 90-110 (mean ~100, std ~6) -->\n  <#assign normalValue = 95 + (i % 20) - 10>\n  <#-- Inject outliers every 50th row (values far from mean) -->\n  <#if i % 50 == 0>\n    <#-- Outlier: either very high (200+) or very low (0-10) -->\n    <#assign value = (i % 100 == 0)?then(250, 5)>\n  <#else>\n    <#assign value = normalValue>\n  </#if>\n{\"id\": ${i}, \"name\": \"Sensor_${i}\", \"value\": ${value}, \"timestamp\": \"2026-02-27T${(i % 24)?string(\"00\")}:${(i % 60)?string(\"00\")}:00Z\"}<#if i_has_next>,</#if>\n</#list>\n]"
                },
                "propertiesSchema": {
                    "type": "object",
                    "properties": {
                        "jsonArrayString": {
                            "type": "string",
                            "title": "JSON Array",
                            "description": "JSON array string where each object becomes a table row"
                        }
                    },
                    "required": [
                        "jsonArrayString"
                    ]
                },
                "propertiesUISchema": {
                    "type": "VerticalLayout",
                    "elements": [
                        {
                            "type": "Control",
                            "scope": "#/properties/jsonArrayString",
                            "options": {
                                "format": "code",
                                "language": "freemarker",
                                "rows": 15
                            }
                        }
                    ]
                },
                "status": null,
                "nodeProgress": null
            },
            "width": 255,
            "height": 100,
            "selected": false,
            "positionAbsolute": {
                "x": 214.765625,
                "y": 576
